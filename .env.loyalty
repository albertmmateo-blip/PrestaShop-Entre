# Loyalty System Environment Variables
# Copy this file to .env.loyalty.local and update with your values
# DO NOT commit .env.loyalty.local to version control!

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL Database Configuration
LOYALTY_DB_HOST=localhost
LOYALTY_DB_PORT=5433
LOYALTY_DB_NAME=loyalty_system
LOYALTY_DB_USER=loyalty_user
LOYALTY_DB_PASSWORD=loyalty_password_change_me

# Test Database Configuration
LOYALTY_DB_TEST_PORT=5434

# =============================================================================
# Application Configuration
# =============================================================================

# Application Environment (development, staging, production)
LOYALTY_ENV=development

# API Configuration
LOYALTY_API_PORT=3000
LOYALTY_API_BASE_URL=http://localhost:3000

# JWT Secret (generate a secure random string for production)
LOYALTY_JWT_SECRET=change_this_to_a_random_string_in_production

# =============================================================================
# Business Rules Configuration
# =============================================================================

# Points earn rate (EUR credited per 1 EUR spent)
LOYALTY_EARN_RATE=0.015

# Points display multiplier (1 point = 0.0001 EUR, display as 1 EUR = 150 points)
LOYALTY_POINTS_MULTIPLIER=10000

# Points expiration period (months)
LOYALTY_EXPIRATION_MONTHS=3

# =============================================================================
# External Services Configuration
# =============================================================================

# Email Service (SendGrid, Amazon SES, etc.)
LOYALTY_EMAIL_PROVIDER=sendgrid
LOYALTY_EMAIL_API_KEY=
LOYALTY_EMAIL_FROM=noreply@yourdomain.com
LOYALTY_EMAIL_FROM_NAME=Loyalty Program

# WhatsApp Business API
LOYALTY_WHATSAPP_PROVIDER=twilio
LOYALTY_WHATSAPP_API_KEY=
LOYALTY_WHATSAPP_PHONE_NUMBER=

# =============================================================================
# PrestaShop Integration
# =============================================================================

# PrestaShop Database Connection (for reading customer data)
PRESTASHOP_DB_HOST=localhost
PRESTASHOP_DB_PORT=3306
PRESTASHOP_DB_NAME=prestashop
PRESTASHOP_DB_USER=root
PRESTASHOP_DB_PASSWORD=prestashop
PRESTASHOP_DB_PREFIX=ps_

# PrestaShop API Configuration
PRESTASHOP_API_URL=http://localhost:8001
PRESTASHOP_API_KEY=

# =============================================================================
# Security Configuration
# =============================================================================

# Enable SSL/TLS for database connections
LOYALTY_DB_SSL=false

# API Rate Limiting
LOYALTY_RATE_LIMIT_ENABLED=true
LOYALTY_RATE_LIMIT_MAX_REQUESTS=100
LOYALTY_RATE_LIMIT_WINDOW_MS=60000

# Session Configuration
LOYALTY_SESSION_SECRET=change_this_to_a_random_string_in_production
LOYALTY_SESSION_TIMEOUT_MINUTES=60

# =============================================================================
# Monitoring and Logging
# =============================================================================

# Log Level (debug, info, warn, error)
LOYALTY_LOG_LEVEL=info

# Log Format (json, text)
LOYALTY_LOG_FORMAT=json

# Enable Sentry Error Tracking
LOYALTY_SENTRY_DSN=
LOYALTY_SENTRY_ENVIRONMENT=development

# =============================================================================
# Background Jobs
# =============================================================================

# Points Expiration Job Schedule (cron format)
LOYALTY_EXPIRATION_JOB_SCHEDULE=0 2 * * *

# Sync Job Schedule (cron format for offline queue sync)
LOYALTY_SYNC_JOB_SCHEDULE=*/5 * * * *

# =============================================================================
# Feature Flags
# =============================================================================

# Enable WhatsApp notifications
LOYALTY_FEATURE_WHATSAPP=false

# Enable email notifications
LOYALTY_FEATURE_EMAIL=true

# Enable QR code fallback for NFC
LOYALTY_FEATURE_QR_CODE=false

# Enable web portal for customers
LOYALTY_FEATURE_WEB_PORTAL=false
# Trigger workflow
