APP_NAME=Loyalty API Test
APP_VERSION=1.0.0
ENVIRONMENT=test
DEBUG=true
HOST=0.0.0.0
PORT=3000

DATABASE_URL=sqlite+aiosqlite:///./test.db

API_KEY_SALT=test_salt_for_testing_only
JWT_SECRET=test_secret_for_testing_only
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100

CORS_ORIGINS=http://localhost:8001
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=INFO
LOG_FORMAT=json

EARN_RATE=0.015
POINTS_MULTIPLIER=10000
EXPIRATION_MONTHS=3
