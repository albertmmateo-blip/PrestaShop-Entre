# Application
APP_NAME=Loyalty API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgresql+asyncpg://loyalty_user:loyalty_password_change_me@localhost:5433/loyalty_system

# Security
API_KEY_SALT=change_this_to_a_secure_random_string_in_production
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# CORS
CORS_ORIGINS=http://localhost:8001,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Business Rules
EARN_RATE=0.015
POINTS_MULTIPLIER=10000
EXPIRATION_MONTHS=3

# External Services (Optional)
EMAIL_PROVIDER=
EMAIL_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# Monitoring (Optional)
SENTRY_DSN=
